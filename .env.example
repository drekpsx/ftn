# Base de donnees PostgreSQL
DATABASE_URL="postgresql://flowdevis:flowdevis@localhost:5432/flowdevis?schema=public"

# Auth (NextAuth) - generer avec `openssl rand -base64 32`
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# URL publique de l'app (utilisee pour generer les liens publics, emails, QR codes)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
